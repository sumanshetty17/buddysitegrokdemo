# ---------------------------------------------------------------------------
# PostgreSQL (Render) -- REQUIRED for production with many sellers/customers
# Create a Postgres database on Render, copy the Internal Database URL here.
# Leave blank for local JSON file mode (data.json).
DATABASE_URL=
# Set to false only for local Postgres without SSL
# PGSSL=false

# Copy this file to ".env" and fill in your own values.
# NEVER share your .env file or commit it to GitHub — it contains secret keys.

# Any random long password-like string. This keeps user logins secure.
JWT_SECRET=change-this-to-a-long-random-string

# Get these from your own Razorpay account: https://dashboard.razorpay.com/app/keys
# Payments made through this app go straight into THIS Razorpay account (your bank account).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# For auto-pay (recurring subscriptions) to work, create a Webhook in your Razorpay
# Dashboard -> Account & Settings -> Webhooks, pointing to:
#   https://yourdomain.com/api/webhooks/razorpay
# Enable these events: subscription.charged, subscription.activated,
# subscription.authenticated, subscription.cancelled, subscription.halted,
# subscription.completed
# Razorpay will show you a "Webhook Secret" when you create it -- paste it here:
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here

# ---------------------------------------------------------------------------
# WhatsApp order notifications (whatsapp.js) -- PLATFORM-WIDE, one connection
# here powers order alerts for every store on BuddySite. Sellers just add
# their number in Payment Method -- nothing else to set up on their end.
#
# 1. Sign up with a WhatsApp Business Solution Provider (Gupshup, Interakt,
#    WATI, Twilio) -- or use Meta's Cloud API directly if you already have
#    business verification with Meta.
# 2. Get your send-message API URL, API key, and the WhatsApp number you're
#    sending FROM.
# 3. If your BSP/Meta requires a pre-approved TEMPLATE for messages you send
#    to a customer who didn't message you first (most do, outside a 24-hour
#    window) -- get that template approved on the BSP/Meta side first, then
#    set WHATSAPP_TEMPLATE_NAME below. Until it's approved, WhatsApp may
#    reject these messages -- that's WhatsApp's policy, not a bug here.
# Leave these blank to keep the feature safely disabled (orders still work
# fine, WhatsApp sends are just logged instead of attempted).
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_SENDER_NUMBER=
WHATSAPP_TEMPLATE_NAME=

# ---------------------------------------------------------------------------
# Customer account OTP delivery (otp.js) -- powers the "forgot password" flow
# on every store's customer account system. A customer picks SMS or email;
# leave the corresponding block blank to keep that method safely disabled
# (accounts and orders still work fine, the OTP is just logged instead of
# sent -- exactly like WhatsApp above until it's configured).
#
# SMS: sign up with a gateway such as MSG91, Fast2SMS, or Twilio.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Email: sign up with a transactional email API such as Resend, SendGrid,
# or Postmark.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Port the server runs on (most hosts set this automatically, leave as is)
PORT=3000
